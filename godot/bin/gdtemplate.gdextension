[configuration]
entry_symbol = "gdtemplate_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://bin/gdtemplate.debug.dll"
windows.release.x86_64 = "res://bin/gdtemplate.dll"
linux.debug.x86_64 = "res://bin/libgdtemplate.debug.so"
linux.release.x86_64 = "res://bin/libgdtemplate.so"
macos.debug = "res://bin/libgdtemplate.debug.dylib"
macos.release = "res://bin/libgdtemplate.dylib"
